{
  "manifest_version": 3,
  "name": "ChatGPT Response Download",
  "version": "1.6.19",
  "description": "Download ChatGPT responses as standalone HTML matching the on-screen render.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChatGPT Response Download — click to reinject",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://images.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://*.oaistatic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
